# ---------- Application ----------
APP_PORT=8080
APP_ENV=development
APP_AUTO_MIGRATE=true
RUN_SEEDER=true
CORS_ALLOWED_ORIGINS=*

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=booking_field
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# ---------- JWT ----------
# Minimal 16 karakter, ganti dengan nilai acak di production.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_HOUR=24

# ---------- Xendit ----------
# Ambil dari dashboard Xendit (Settings > Developers > API Keys & Callbacks).
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_INVOICE_DURATION=3600

# ---------- Frontend ----------
FRONTEND_URL=http://localhost:3000

# ---------- Aturan bisnis booking ----------
BOOKING_MIN_HOUR=1
BOOKING_MAX_HOUR=8
BOOKING_CANCEL_MIN_HOUR=24
BOOKING_EXPIRER_MINUTE=1

# ---------- Application ----------
APP_PORT=8080
APP_ENV=development
APP_AUTO_MIGRATE=true
RUN_SEEDER=true
CORS_ALLOWED_ORIGINS=*

# ---------- Observability ----------
# Optional OTLP/HTTP trace collector endpoint, e.g. http://localhost:4318.
# Metrics are exposed at /metrics; traces are exported only when endpoint is set.
OTEL_SERVICE_NAME=arenago-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=booking_field
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# ---------- JWT ----------
# Minimal 16 karakter, ganti dengan nilai acak di production.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_HOUR=2

# ---------- Xendit ----------
# Ambil dari dashboard Xendit (Settings > Developers > API Keys & Callbacks).
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_INVOICE_DURATION=3600

# ---------- OpenRouter chatbot ----------
# Set this only in local .env or the deployment secret manager.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---------- Frontend ----------
FRONTEND_URL=http://localhost:3000

# ---------- Aturan bisnis booking ----------
BOOKING_MIN_HOUR=1
BOOKING_MAX_HOUR=8
BOOKING_CANCEL_MIN_HOUR=24
BOOKING_EXPIRER_MINUTE=1

# ---------- MongoDB (Notifikasi & Pengingat Jadwal) ----------
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=booking_field
REMINDER_WORKER_INTERVAL_SEC=60
REMINDER_H24_ENABLED=true
REMINDER_H2_ENABLED=true

# ---------- WhatsApp Cloud API ----------
# Used by cmd/notification-worker. Requires approved templates and recipient opt-in.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com/v22.0
WHATSAPP_TEMPLATE_LANGUAGE=id
WHATSAPP_PAYMENT_REMINDER_DELAY_MINUTES=10
WHATSAPP_TEMPLATE_PAYMENT_REMINDER=payment_reminder
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=booking_confirmed
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=booking_cancelled
WHATSAPP_TEMPLATE_BOOKING_RESCHEDULED=booking_rescheduled
WHATSAPP_TEMPLATE_MATCH_REMINDER=match_reminder
WHATSAPP_TEMPLATE_VENUE_ANNOUNCEMENT=venue_announcement

# ---------- RabbitMQ (event delivery to notification worker) ----------
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=arenago.events
RABBITMQ_NOTIFICATION_QUEUE=arenago.notification.events
RABBITMQ_RETRY_EXCHANGE=arenago.events.retry
RABBITMQ_RETRY_QUEUE=arenago.notification.retry
RABBITMQ_DLX_EXCHANGE=arenago.events.dlx
RABBITMQ_DEAD_LETTER_QUEUE=arenago.notification.dead
RABBITMQ_RETRY_DELAY_SECONDS=30
RABBITMQ_MAX_RETRIES=5
OUTBOX_PUBLISHER_INTERVAL_SECONDS=1

# ---------- Redis (Cache data lapangan, opsional) ----------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
FIELD_CACHE_TTL_MINUTES=5
